# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.

# Required: path to your SUMO installation root
SUMO_HOME=

# Optional: override the default scenario directory
SUMO_SCENARIO_PATH=backend/sim/mahalla-scenario

# Optional: Gemini / Google AI credentials (leave blank to use fallback mode)
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=

# Optional: AI model override (default: gemini-2.0-flash)
AI_MODEL=gemini-2.0-flash
